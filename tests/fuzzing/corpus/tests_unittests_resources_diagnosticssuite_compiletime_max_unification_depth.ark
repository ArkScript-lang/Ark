(macro suffix-dup (sym x){
    ($if (+ x 1)
        est_func
        (macro p (a b c) (* a b c)))
    ($symcat sym x)})

(macro partial (func ...defargs) {
    (macro bloc (suffix-dup a (len defargs)))
    (fun (bloc) (func ...defargs bloc))
    ($undef bloc)})

(let test
    (partial
        (* a b)
        (let inner (partial te t_func 0))
        (let est_func
                (macro partial (func ...defargs) {
                    (macro bloc (suffix-dup a (len defargs)))
                    (fun (bloc) (func ...defargs bloc))
