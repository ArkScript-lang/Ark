(let a 0)

#00000000000000
(if (= (type a) "Number")
  (print "num"))
#00000000000000
(if (= "Number" (type a))
  (print "num"))

(let foo (fun () {
  #0000000000000000000000
  (if (= (type a) "Number")
    (print "num"))
  #00000000000000000000000
  (if (= "Number" (type a))
    (print "num")) }))

(foo)
