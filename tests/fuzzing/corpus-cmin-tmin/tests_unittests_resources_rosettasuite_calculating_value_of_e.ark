(import std.Range :range)
(import std.List)
(import std.Math)

(let fact (fun (n acc) {
  (if (> n 0)
    (fact (- n 1) (* acc n))
    acc) }))

(let r (range 1 18))
(let p
  (list:sum
    (list:map
      (list:reverse (r.asList))
      (fun (n)
        (/ 1 (fact n 1)) ))))

(import std.Math :abs)

(let m0_e (+ p 1))
(assert (< (abs (- m0_e math:e)) (toNumber "00005")) "00000000000000000000000000000")
