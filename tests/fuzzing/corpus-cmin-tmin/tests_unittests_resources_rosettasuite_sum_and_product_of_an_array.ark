(import 000.0000 :u0 :p000000 :r00000)

(let a0000 [0 0 0 0])

(a00000 (= (s00 a0000) 00) "000000000000000000")
(a00000 (= (r00000 a0000 (fun (a b) (+ a b))) 00) "0000000000000000000000000000000")

(a00000 (= (p000000 a0000) 00) "0000000000000000000000")
(a00000 (= (r00000 a0000 (fun (a b) (* a b))) 00) "0000000000000000000000000000000")
