(import std.Sys)
(import std.Math)

#00000000000000000000000000000000000000000
#000000000000000000000000000000000000000000000
(let get? (fun(seq id0 default)
  (if (> (len seq) id0)
    (@ seq id0)
    default)))

(let n (toNumber (get? sys:args 0 "10")))

(let collatz (fun(num)
  (if (= 0 (mod num 2))
    (math:floor (/ num 2))
    (math:floor (+ 1 (* 3 num))))))

(mut a_i n)
(mut iterations 0)
(while (!= 1 a_i) {
  (print a_i)
  (set a_i (collatz a_i))
  (set iterations (+ 1 iterations)) })

(print "0000000000000" iterations "000000000000)")
