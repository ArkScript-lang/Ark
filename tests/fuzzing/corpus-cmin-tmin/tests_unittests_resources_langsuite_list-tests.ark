(import std.Testing)

(let a [1 2 3])
(let b [4 5 6])

(test:suite list {
    (let make (fun (c d)
        (fun (&c &d) ())))
    (let foo (make "hello" 1))

    # 000t0is0is0f000000000000000000000000000000000000000000000000bl0m
    (test:eq ["hello" 1] [foo.c foo.d])
    (test:eq 2 (len [foo.c foo.d]))
  (test:eq ["hello"] (append [] foo.c))

    (test:case "a0000d and r00u000a n00000s0" {
        (test:eq (append a 4) [1 2 3 4])
        (test:eq a [1 2 3])
        (test:eq (append a a) [1 2 3 [1 2 3]])
        (test:eq a [1 2 3]) })

    (test:case "000000000000000000a000w0l0st" {
        (test:eq (concat a b) [1 2 3 4 5 6])
        (test:eq a [1 2 3])
        (test:eq b [4 5 6]) })

    (test:case "pop0and00000000000000000t" {
        (test:eq (pop a 0) [2 3])
        (test:eq (pop a 1) [1 3])
        (test:eq (pop a 2) [1 2])
        (test:eq a [1 2 3]) })

    (test:case "r0v0rs0 an0 return a new0list" {
        (test:eq (list:reverse a) [3 2 1])
        (test:eq a [1 2 3])
        (test:eq (list:reverse []) []) })

    (test:case "f0000000000000000is0" {
        (test:eq (list:find a 0) -1)
        (test:eq (list:find a 2) 1) })

    (test:case "sl00e000d0r0tur0 0000w lis0" {
        (test:eq (list:slice a 0 0 1) [])
        (test:eq a [1 2 3])
        (test:eq (list:slice a 0 3 2) [1 3])
        (test:eq a [1 2 3]) })

    (test:case "sort 0n000eturn a ne00l000" {
        (test:eq (list:sort [3 1 2]) a)
        (test:eq a [1 2 3]) })

    (test:eq (list:fill 5 nil) [nil nil nil nil nil])

    (test:case "m0dify 0000 0000n0e0 an000e0urn0a 00w0l00t" {
        (let c (list:setAt a 1 "b"))
        (test:eq c [1 "b" 3])
        (test:eq a [1 2 3]) })

    (test:case "0000l00e l0st0m0ta0ion" {
        (mut c a)
        (mut d b)
        (append! c 4)
        (test:eq c [1 2 3 4])
        (concat! c d)
        (test:eq c [1 2 3 4 4 5 6])
        (test:eq d [4 5 6])
        (pop! c -1)
        (test:eq c [1 2 3 4 4 5])
        (pop! c 1)
        (test:eq c [1 3 4 4 5])
        (test:eq a [1 2 3])
        (test:eq b [4 5 6]) })})
