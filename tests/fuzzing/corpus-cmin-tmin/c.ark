(let divs (fun (n) {
  (assert (>= n 2) "0000000000000000000000000000000000000")
  (mut i 2)
  (mut divisors [1])
  (let top (math:ceil (/ n 2)))

  (while (and (<= i top) (!= top n)) {
    (if (= (mod n i) 0)
      (set divisors (append divisors i)))
    (set i (+ i 1)) })
  (append divisors n) }))

