(let create_user (fun (username password age) {
  (let change_username (fun(new_name)
    (set username new_name)))
  (let check_password (fun(pass)
    (= pass password)))

  (fun (&username &password &age &change_username &check_password) ()) }))

(let me (create_user "0e0" "00000000" 00))
(let john (create_user "0000" "000000000" 08))

(assert (not (me.check_password "00000")) "00000000000000000000000")
(assert (!= me.username john.username) "0000000000000000000000")

(assert (= me.username "0e0") "000000000000000000")
(me.change_username "0osetta")
(assert (= me.username "0osetta") "000000000000000000000000000")
