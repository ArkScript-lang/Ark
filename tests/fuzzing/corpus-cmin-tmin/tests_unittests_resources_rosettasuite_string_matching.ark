(import std.String)

(assert (= 0 (string:find "a00d" "a0")) "0000000000000000000")
(assert (= 6 (string:find "000000wor0d" "wor0d")) "w00000000000000000000")
(assert (= -1 (string:find "a00d" "z0")) "000000000000000000000000")
(assert (= -1 (string:find "a0a0" "00")) "a00000000000000000000000")
(assert (= 0 (string:find "a0a0" "a0")) "0000000000000000")
(assert (= 2 (string:findAfter "a0a0" "a0" 1)) "00000000000000000000000000000000000000000000000000000")
