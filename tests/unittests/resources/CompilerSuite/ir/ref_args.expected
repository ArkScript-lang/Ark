global
	LOAD_CONST 0
	STORE 0
	PUSH_RETURN_ADDRESS L0
	LOAD_CONST 2
	LOAD_CONST 2
	CALL_SYMBOL_BY_INDEX 0, 2
.L0:
	POP 0
	LOAD_CONST 3
	STORE 3
	PUSH_RETURN_ADDRESS L1
	LOAD_CONST 2
	LOAD_CONST 2
	CALL_SYMBOL_BY_INDEX 0, 2
.L1:
	POP 0
	LOAD_CONST 4
	STORE 4
	PUSH_RETURN_ADDRESS L3
	LOAD_CONST 2
	LOAD_CONST 2
	CALL_SYMBOL_BY_INDEX 0, 2
.L3:
	POP 0
	HALT 0

page_1 (f (2 arguments) recursive simple function)
	STORE 1
	STORE 2
	LOAD_SYMBOL 1
	LOAD_FAST_BY_INDEX 0
	LOAD_CONST 1
	SUB 0
	TAIL_CALL_SELF 0
	RET 0
	HALT 0

page_2 (g (2 arguments) recursive simple function)
	STORE 1
	STORE 2
	LOAD_SYMBOL 1
	LOAD_FAST_BY_INDEX 0
	LOAD_CONST 1
	SUB 0
	TAIL_CALL_SELF 0
	RET 0
	HALT 0

page_3 (h (2 arguments) recursive simple function)
	STORE 1
	STORE 2
	LOAD_CONST 5
	SHORTCIRCUIT_OR L2
	LOAD_SYMBOL 1
.L2:
	LOAD_FAST_BY_INDEX 0
	LOAD_CONST 1
