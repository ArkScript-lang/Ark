(import std.Testing)

(test:suite module {
    (test:case "import and call plugin" {
        (import testmodule)

        (test:eq (testmodule:foo 1) 1)
        (test:eq (testmodule:foo) nil) })

    (test:case "load twice the same module without error" {
        (import testmodule)
        (import testmodule) })})
