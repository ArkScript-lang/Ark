(import std.List :range)
(import std.List)
(import std.Math)

(let fact (fun (n acc) {
  (if (> n 0)
    (fact (- n 1) (* acc n))
    acc) }))

(let r (range 1 18 1))
(let p
  (list:sum
    (list:map
      (list:reverse r)
      (fun (n)
        (/ 1 (fact n 1)) ))))

(import std.Math :abs)

(let my_e (+ p 1))
(assert (< (abs (- my_e math:e)) (toNumber "1e-15")) "computed e is near the math:e")
