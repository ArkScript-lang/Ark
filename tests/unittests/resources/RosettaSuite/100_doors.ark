(import std.List :range :forEach)
(import std.List)

(mut doors (list:fill 100 false))
(let r (range 0 100 1))

(forEach r
  (fun (i) {
    (mut j i)
    (while (< j 100) {
      (@= doors j (not (@ doors j)))
      (set j (+ j i 1)) })}))

(assert (= [0 3 8 15 24 35 48 63 80 99]
  (list:map
    (list:filter
      (list:zipWithIndex doors)
      (fun (e)
        (@ e 1)))
    (fun (e) (@ e 0))))
    "wrong solution")
