(import std.Math :sqrt :prime?)
(import std.List)
(import std.String)

(let ascending (fun (n f) {
  (mut nums (list:iota 1 9))
  (mut i 0)
  (mut matched [])

  (while (and (< (len matched) n) (< i (len nums))) {
    (let val (@ nums i))
    (if (f val)
      (append! matched val))

    (mut r (list:range (+ 1 (mod val 10)) 10 1))
    (set r (list:map r (fun (k) (+ k (* 10 val)))))
    (concat! nums r)

    (set i (+ 1 i)) })

  matched }))

(print (string:join (ascending 100 prime?) ", "))
